<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 联网必需：页面代理与更新检查都走它 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 分体式更新：下载完新 APK 后拉起系统安装器（仍需用户在系统里允许"未知来源"） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 后台保活：远程会话在后台继续跑，不被系统当普通后台进程回收 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14（API 34）起前台服务必须声明具体类型对应的权限，否则 startForeground 直接抛异常 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13（API 33）起常驻通知要用户授权：没有它服务能跑，但通知不显示 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 只是声明给页面用：保活服务自己不开 WakeLock（费电），页面临时需要时才能申请 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 拉起系统「忽略电池优化」授权页（data=package:<pkg> 那条 ACTION 需要它） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        保存到「下载」目录（/__ds_download/save）：
        * Android 10（API 29）起走 MediaStore.Downloads，**不需要**任何存储权限；
        * Android 9（API 28，本应用 minSdk）只能直接写公共下载目录，
          需要 WRITE_EXTERNAL_STORAGE，运行时在 28 上申请。
        因此这条权限必须带 maxSdkVersion="28"：29+ 声明它既没用、又会让安装器提示
        「需要访问所有照片/媒体」之类的敏感权限，属于审核与体验双重扣分。
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
        权限中心（/__ds_keepalive/permissions.json + /open）刻意**不**新增任何权限：
        「通知 / 省电 / 自启动 / 应用详情 / 流量」全部靠跳系统设置页 + 读系统状态实现，
        精确闹钟与悬浮窗这两格也只跳页面、不申请（本应用不排精确定时任务，也不需要悬浮窗，
        声明 SCHEDULE_EXACT_ALARM / SYSTEM_ALERT_WINDOW 只会吓到用户、还会触发应用商店的
        敏感权限审核）。工具脚本 tools/check-android-shell.cjs 对清单权限有白名单断言，
        多声明一个就会变红 —— 真要加权限，记得同步更新那边的 expected 列表。
    -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.DeepSeekTablet">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|navigation"
            android:exported="true"
            android:resizeableActivity="true"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            后台保活前台服务（/__ds_keepalive/* 调起来的那一个）。

            * exported="false"：只有本应用能起它，外部 App 不能拿它当免死金牌
            * foregroundServiceType="dataSync"：与 RemoteKeepAliveService.startForegroundCompat()
              里传的 ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC 必须一致；
              Android 14（API 34）上不一致或缺失会抛 MissingForegroundServiceTypeException
        -->
        <service
            android:name=".RemoteKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 安装器进程读不到应用私有目录：apk 必须包成带授权的 content:// URI 交给它 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
