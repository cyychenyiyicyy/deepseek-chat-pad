<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景：一条朝左的鲸鱼 + 上方水花 + 一只"挖空"的眼睛。
  viewport 108x108，图形收在中间 66dp 安全区内，圆形/方形/圆角遮罩都不会切到主体。
  纯白路径，眼睛用底色填充，视觉上等同挖洞。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 身体：从吻部（左）绕过背部到尾部，尾巴向右上挑出鳍 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M31,56 C31,43 44,33 59,33 C72,33 81,40 84,50 L88,46 C88,46 87,59 85,62 L81,66 C77,72 67,76 56,76 C41,76 31,68 31,56 Z" />

    <!-- 头顶水花（描边，无填充） -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M58,32 C58,26 62,22 68,22" />

    <!-- 眼睛：与底色同色，白鲸身上留一个洞 -->
    <path
        android:fillColor="#FF0F1115"
        android:pathData="M43,52 a4,4 0 1 0 8,0 a4,4 0 1 0 -8,0 Z" />
</vector>
